# Streamlit Community Cloud secrets template.
# =============================================================
# On share.streamlit.io, open your deployed app > Settings > Secrets
# and paste the same TOML content there (with real values filled in).
# NEVER commit real credentials to git — this file is a template only,
# .streamlit/secrets.toml (without .example) is in .gitignore.
#
# streamlit_app.py promotes every key here into os.environ at boot,
# so the rest of the app reads them via os.environ.get(...) exactly
# like it does for local .env development.

# ---------------------------------------------------------------
# AWS — required for real Cost Explorer / Bedrock / CloudWatch reads
# ---------------------------------------------------------------
# Create these in the AWS account whose data the app should show:
#   1. IAM > Users > Create user (no console access)
#   2. Attach the SAME inline policy from infra/instance-role-policy.json
#      (read-only Cost Explorer + Bedrock + CloudWatch + resource inventory)
#   3. Create an access key of type "Application running outside AWS"
#   4. Paste the two values here
#
# Region MUST include Bedrock support (us-west-2 is safe).
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_DEFAULT_REGION = "us-west-2"
AWS_REGION = "us-west-2"

# ---------------------------------------------------------------
# GitHub — optional, enables the PR Predictor / Anomalies "look
# at repo files" tools. Without it, those features gracefully
# degrade to AWS-only mode.
# ---------------------------------------------------------------
# Generate at https://github.com/settings/tokens/new
#   - "Fine-grained personal access token"
#   - Only-read permission for the repos you want the bot to see
#     (Contents: read-only is enough for the current tools)
# GITHUB_TOKEN = "github_pat_..."

# ---------------------------------------------------------------
# Optional: SMTP settings if you want the in-app "Notify" buttons
# to actually send email. Without them the buttons show but no
# mail leaves the container.
# ---------------------------------------------------------------
# COSTSENSE_NOTIFY_TO = "finops@example.com"
# COSTSENSE_NOTIFY_FROM = "costsense-bot@example.com"
# COSTSENSE_SMTP_HOST = "smtp.example.com"
# COSTSENSE_SMTP_PORT = "587"
# COSTSENSE_SMTP_USER = ""
# COSTSENSE_SMTP_PASSWORD = ""
